# Host directory containing the project (or AI-KIDO checkout/install target).
AIKIDO_HOST_PARENT=./data
AIKIDO_DIR=aikido
AIKIDO_REF=main
AIKIDO_REPOSITORY=https://github.com/lcalmejane/aikido.git
# For a separate trusted project/fork only. The official base is always protected.
AIKIDO_WRITABLE=false
AIKIDO_VOLUME_MODE=ro
AIKIDO_INCLUDE_SPEC=false
# Generic local RAG by default. Set aikido explicitly for AI-KIDO workflows.
KIMONO_CORPUS_MODE=rag
# No trace files: errors only on stderr; debug is opt-in and rate-limited per native operation.
KIMONO_LOG_LEVEL=error
# Docker logs rotate at 2 x 5 MB/container. External collectors: use a Compose logging override.
KIMONO_SEMANTIC_DEVICE=auto
# Experimental code-only profile is paused by default to avoid extra indexing/search work.
# To evaluate it explicitly, set the enable flag and provide a supported local model bundle.
# KIMONO_CODE_PROFILE_ENABLED=false
# KIMONO_CODE_MODEL_HOST_DIR=./models/code
# KIMONO_CODE_MODEL_DIR=/opt/kimono/code-model
# Keep the Rust runtime, model and up to four index generations warm per server.
# Set false to roll back to one native process per semantic operation.
KIMONO_SEMANTIC_PERSISTENT_WORKER=true
# Per-process auto sizing within visible host/container CPU and available RAM.
# Percentages are planning budgets, not hard OS limits; workers duplicate model memory.
KIMONO_SEMANTIC_CPU_PERCENT=80
KIMONO_SEMANTIC_MEMORY_PERCENT=80
KIMONO_SEMANTIC_WORKERS=auto
KIMONO_SEMANTIC_THREADS=auto
KIMONO_SEMANTIC_BATCH=auto

# Optional managed SSH/HTTPS account: path INSIDE the container.
# Use a local Compose override to mount its private directory read-only.
# Schema, permissions and rotation: README "Dynamic per-instance Git profile".
# KIMONO_GIT_PROFILE_FILE=/run/kimono-git/profile.json

# MCP HTTP listener. Generate a token with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-long-random-token
MCP_PORT=3000