{
  "name": "kimono-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for discovering and activating AI-KIDO knowledge-base capabilities",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcalmejane/kimono-mcp-server.git"
  },
  "type": "module",
  "bin": {
    "kimono-mcp-server": "./dist/index.js",
    "kimono": "./dist/cli.js"
  },
  "scripts": {
