{
  "name": "kimono-mcp-server",
  "version": "0.9.3",
  "description": "Local RAG for source code and documentation with lexical and semantic retrieval over MCP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcalmejane/kimono-mcp-server.git"
  },
  "type": "module",
  "bin": {
    "kimono-mcp-server": "./dist/index.js",
    "kimono": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx src/index.ts",
    "dev:cli": "tsx src/cli.ts",
    "dev:check": "git --version && gh --version && jq --version",
    "infos": "tsx src/cli.ts infos",
    "sync": "tsx src/cli.ts sync",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck:bench",
    "typecheck:bench": "tsc --noEmit --strict --skipLibCheck --module NodeNext --target ES2022 --types node scripts/bench-harness.ts scripts/bench-db.ts",
    "bundle:native": "node scripts/package-native-bundle.mjs",
    "test:vscode": "node --test vscode/test/*.cjs",
    "package:vscode": "node scripts/package-vscode.mjs",
    "test:vscode:integration": "node scripts/test-vscode-package.mjs",
    "bench:harness": "tsx scripts/bench-harness.ts",
    "bench:db": "tsx scripts/bench-db.ts",
    "bench:db:check": "tsx scripts/bench-db.ts validate --check-index"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "fast-xml-parser": "^5.3.0",
    "yauzl": "^3.2.0",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "ajv": "^8.20.0",
    "@types/node": "^24.0.0",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
