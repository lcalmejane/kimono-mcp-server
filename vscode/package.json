{
  "name": "kimono-rag-mcp",
  "displayName": "Kimono RAG MCP by AI-KIDO",
  "description": "Local project RAG and AI-KIDO MCP with embedded lexical and semantic search.",
  "version": "0.6.4",
  "publisher": "ai-kido",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lcalmejane/kimono-mcp-server.git"
  },
  "engines": { "vscode": "^1.106.0" },
  "categories": ["AI", "Machine Learning", "Other"],
  "keywords": ["mcp", "rag", "copilot", "semantic search", "ai-kido"],
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#0f1220", "theme": "dark" },
  "main": "./extension.cjs",
  "files": ["extension.cjs", "native.cjs", "stdio.cjs", "panel.cjs", "mcp-client.cjs", "search.cjs", "status.cjs", "management/**", "media/**", "native/**", "runtime/**", "server/**", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Kimono requires a trusted workspace before starting a knowledge server."
    },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      { "id": "kimono.mcp", "label": "Kimono MCP" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "kimono", "title": "Kimono MCP", "icon": "media/kimono.svg" }
      ]
    },
    "views": {
      "kimono": [
        { "id": "kimono.status", "name": "Kimono MCP", "icon": "media/kimono.svg" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "kimono.openPanel", "when": "view == kimono.status", "group": "navigation" }
      ]
    },
    "commands": [
      { "command": "kimono.openPanel", "title": "Kimono: Open Management Panel", "icon": "media/kimono.svg" },
      { "command": "kimono.testSearch", "title": "Kimono: Test a Search" },
      { "command": "kimono.startIndex", "title": "Kimono: Start Indexing Now" },
      { "command": "kimono.configure", "title": "Kimono: Open Settings" },
      { "command": "kimono.setToken", "title": "Kimono: Set Remote Bearer Token" },
      { "command": "kimono.clearToken", "title": "Kimono: Clear Remote Bearer Token" }
    ],
    "configuration": {
      "title": "Kimono MCP",
      "properties": {
        "kimono.corpusMode": {
          "type": "string",
          "enum": ["rag", "aikido"],
          "default": "rag",
          "scope": "machine",
          "description": "RAG (default) indexes generic UTF-8 source/docs read-only. Select AI-KIDO explicitly for knowledge discovery with an index entry point. Both modes respect .gitignore and dependency/build exclusions."
        },
        "kimono.configFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to a host-controlled corpus JSON config (extensions, filenames, include/exclude globs and limits). Never auto-loaded from a project. corpusMode overrides its mode."
        },
        "kimono.mode": {
          "type": "string",
          "enum": ["embedded", "remote", "disabled"],
          "default": "embedded",
          "scope": "machine",
          "description": "Embedded uses the bundled local server. Remote connects to an existing HTTP MCP. Disabled removes the definitions."
        },
        "kimono.root": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Knowledge directory, absolute or relative to each workspace folder. Empty uses that folder. Caches stay outside it."
        },
        "kimono.url": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Remote HTTP MCP endpoint. HTTPS required except localhost. Never put credentials in this URL."
        },
        "kimono.gitProfileFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to the current user's private 0600/0400 Git read-profile JSON outside the knowledge root. Never put secrets in settings."
        }
      }
    }
  }
}
